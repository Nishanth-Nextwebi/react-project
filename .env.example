# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI="mongodb+srv://..."

# NextAuth Configuration
NEXTAUTH_SECRET="f69df919b4e339dae75c61eb63d91653bc07ea8fa538bd8c6a0c5de2cfa8a93b" # Secure random 32-byte secret
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# WhatsApp Cloud API credentials
WHATSAPP_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

# Cron trigger authorization secret
CRON_SECRET="your-cron-endpoint-secret-key"
