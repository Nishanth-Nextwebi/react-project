# MySQL connection URI for Prisma.
# Local/dev example (no TLS):
DATABASE_URL="mysql://user:password@localhost:3306/policyflow"
# Aiven MySQL (production) example - Aiven requires TLS, hence ssl-mode=REQUIRED:
# DATABASE_URL="mysql://avnadmin:password@your-service-name.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# Optional: PEM contents of the database provider's CA certificate, for strict
# TLS certificate verification (recommended for Aiven - download from the
# Aiven console's "CA certificate" field for your service). If unset while
# ssl-mode=REQUIRED is present in DATABASE_URL, TLS is still used but
# verified against Node's default trust store instead.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional: MySQL connection pool size per running instance (mariadb driver
# default is 10). On serverless hosts (e.g. Vercel) where many function
# instances can run concurrently, each with its own pool, keep this low
# relative to your Aiven plan's max_connections limit - e.g. 3-5.
# DATABASE_CONNECTION_LIMIT=5

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-random-32-byte-secret-and-put-it-here"
NEXTAUTH_URL="http://localhost:3000"
# Production: set NEXTAUTH_URL to your deployed origin, e.g. https://your-app.example.com

# Google OAuth Credentials (used by GoogleProvider in src/lib/auth.ts - first
# Google sign-in auto-provisions a new "employee" user)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Not currently used by any route - the Track FollowUp page
# (/dashboard/follow-up) opens WhatsApp/the phone dialer directly via
# wa.me / tel: links (see src/components/PhoneActions.tsx) rather than
# calling the WhatsApp Cloud API server-side, so no credentials are needed.
# Kept here as a placeholder in case server-side sending is added later.
WHATSAPP_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

# Cron trigger authorization secret (placeholder - not currently read by any
# route in this codebase)
CRON_SECRET="your-cron-endpoint-secret-key"
