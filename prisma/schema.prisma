generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// VehicleType members use @map because Prisma enum identifiers cannot
// contain hyphens - the underlying stored/returned value is unchanged
// ("Two-Wheeler", etc.), only the in-schema identifier differs. See
// src/repositories/VehicleRepository.ts's WIRE_TO_PRISMA_VEHICLE_TYPE /
// PRISMA_TO_WIRE_VEHICLE_TYPE for the translation layer this requires.
// ---------------------------------------------------------------------------

enum Role {
  admin
  employee
}

enum VehicleType {
  TwoWheeler  @map("Two-Wheeler")
  FourWheeler @map("Four-Wheeler")
  Commercial
  Other
}

// ---------------------------------------------------------------------------
// User
// id has no @default(): every id in this schema is a 24-character
// MongoDB-ObjectId-shaped hex string, minted by src/lib/objectId.ts at
// creation time in each repository. This preserves the id shape (and the
// Zod /^[0-9a-fA-F]{24}$/ reference-id validators in src/lib/validations.ts)
// from the original Mongoose implementation without any frontend changes.
// ---------------------------------------------------------------------------

model User {
  id       String  @id
  name     String
  email    String  @unique
  password String?
  role     Role    @default(employee)
  isActive Boolean @default(true)
  googleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customersCreated Customer[]    @relation("CustomerCreatedBy")
  customersUpdated Customer[]    @relation("CustomerUpdatedBy")
  vehiclesCreated  Vehicle[]     @relation("VehicleCreatedBy")
  vehiclesUpdated  Vehicle[]     @relation("VehicleUpdatedBy")
  policiesCreated  Policy[]      @relation("PolicyCreatedBy")
  policiesUpdated  Policy[]      @relation("PolicyUpdatedBy")
  activityLogs     ActivityLog[]
}

// ---------------------------------------------------------------------------
// Customer
// phone is intentionally NOT @unique at the database level, matching the
// original Mongoose schema exactly: uniqueness among active customers is
// enforced only in src/services/customerService.ts (a customer can share a
// phone number with a *deactivated* customer record).
// ---------------------------------------------------------------------------

model Customer {
  id       String  @id
  name     String  @db.VarChar(100)
  phone    String  @db.VarChar(15)
  email    String  @default("") @db.VarChar(255)
  address  String  @default("") @db.VarChar(300)
  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User   @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  policies Policy[]

  @@index([phone])
  @@index([isActive])
  @@index([name, phone, address])
}

// ---------------------------------------------------------------------------
// Vehicle
// vehicleNumber/engineNumber/chassisNumber are @unique globally (not scoped
// to isActive), matching the original Mongoose schema's `unique: true`
// exactly - a deactivated vehicle permanently reserves its registration/
// engine/chassis numbers (the app-level service checks only guard against
// *active* duplicates, but the DB constraint itself is global in both the
// original and this implementation).
// ---------------------------------------------------------------------------

model Vehicle {
  id            String      @id
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  vehicleNumber String      @unique @db.VarChar(15)
  vehicleType   VehicleType
  manufacturer  String      @db.VarChar(50)
  model         String      @db.VarChar(50)
  year          Int
  engineNumber  String      @unique @db.VarChar(30)
  chassisNumber String      @unique @db.VarChar(30)
  color         String      @default("") @db.VarChar(30)
  isActive      Boolean     @default(true)

  createdById String
  createdBy   User   @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User   @relation("VehicleUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies Policy[]

  @@index([customerId])
  @@index([isActive])
  @@index([model])
  @@index([vehicleNumber, engineNumber, chassisNumber, model])
}

// ---------------------------------------------------------------------------
// Policy
// customer is kept as a direct FK alongside vehicle (not derived through
// vehicle -> customer), matching the original PolicyService/dashboard route
// which queries policies by customer directly.
//
// [isActive, expiryDate] and [isActive, createdAt] are compound indexes for
// query performance (dashboard stats/charts and the WhatsApp reminder
// engine both filter on exactly these two-column combinations) - additive,
// does not change any query result or business rule.
// ---------------------------------------------------------------------------

model Policy {
  id               String   @id
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  policyNumber     String   @unique @db.VarChar(50)
  insuranceCompany String   @db.VarChar(100)
  policyType       String   @db.VarChar(50)
  premiumAmount    Float
  startDate        DateTime
  expiryDate       DateTime
  extraField1      String   @default("") @db.VarChar(100)
  extraField2      String   @default("") @db.VarChar(100)
  extraField3      String   @default("") @db.VarChar(100)
  comments         String   @default("") @db.VarChar(1000)
  attachmentUrl    String   @default("") @db.VarChar(500)
  isActive         Boolean  @default(true)

  createdById String
  createdBy   User   @relation("PolicyCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User   @relation("PolicyUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([isActive])
  @@index([isActive, expiryDate])
  @@index([isActive, createdAt])
}

// ---------------------------------------------------------------------------
// ActivityLog
// No isActive (never soft-deleted) and no updatedAt, matching the original
// Mongoose schema's write-once audit-log semantics ({ timestamps: {
// createdAt: true, updatedAt: false } }) exactly. ipAddress is carried over
// from the original schema even though no current code path sets it.
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String   @default("System") @db.VarChar(255)
  action    String   @db.VarChar(100)
  details   String   @db.VarChar(1000)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
